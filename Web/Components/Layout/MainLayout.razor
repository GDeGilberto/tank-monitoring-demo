@inherits LayoutComponentBase
@inject IConfiguration Configuration
@inject IJSRuntime JS

<div class="page">
    <div class="sidebar @(isMenuVisible ? "show" : "")">
        <NavMenu>
            <buttonClose>
                <button @onclick="HandleMenuToggle" class="btn-close bg-light"></button>
            </buttonClose>
        </NavMenu>
    </div>

    <main>
        <div class="top-row px-3 px-md-4">
            <div class="d-flex align-items-center brand-wrap">
                @if (!isMenuVisible)
                {
                    <button class="btn btn-outline-light menu-toggle fade @(!isMenuVisible ? "show" : "")" type="button" @onclick="HandleMenuToggle">
                        <i class="bi bi-list"></i>
                    </button>
                }
                <div class="company-brand">
                    <img src="brand/isotipo.svg" alt="Isotipo de Monitoreo de tanques" class="company-logo" />
                    <span class="brand-title @(isMenuVisible ? "d-none" : "")">Monitoreo de tanques</span>
                </div>
            </div>

            @if (IsDemo)
            {
                <span class="badge text-bg-warning" title="Los datos que ves los genera un simulador">
                    <i class="bi bi-exclamation-triangle-fill"></i> <span class="d-none d-lg-inline">Datos simulados · demo de solo lectura</span><span class="d-lg-none">Demo</span>
                </span>
            }
        </div>

        <article class="content px-3 px-md-4">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui">
    Se ha producido un error no controlado.
    <a href="" class="reload">Recargar</a>
    <a class="dismiss">🗙</a>
</div>

@code {
    // Cerrado por defecto (movil); en pantallas anchas se abre tras el primer render.
    private bool isMenuVisible;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            if (await JS.InvokeAsync<bool>("layoutHelpers.isWide"))
            {
                isMenuVisible = true;
                StateHasChanged();
            }
        }
        catch (JSException) { }
        catch (InvalidOperationException) { }
    }

    private bool IsDemo => Configuration.GetValue<bool>("Demo:Enabled");

    private void HandleMenuToggle()
    {
        isMenuVisible = !isMenuVisible;
    }
}
