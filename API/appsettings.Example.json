{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Hangfire": "Warning",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Database=monitoring;Username=app;Password=<definir-por-variable-de-entorno>",
    "HangfireConnection": "Host=localhost;Database=monitoring;Username=app;Password=<definir-por-variable-de-entorno>"
  },
  "Reader": {
    "Mode": "Serial"
  },
  "SerialPort": {
    "PortName": "COM1",
    "BaudRate": 9600,
    "DataBits": 8,
    "Parity": "None",
    "StopBits": "One",
    "Handshake": "None",
    "ReadTimeout": 500,
    "WriteTimeout": 500
  },
  "Sitio": {
    "Id": 1
  },
  "Jobs": {
    "Enabled": true,
    "InventoryCron": "*/3 * * * *",
    "DeliveriesCron": "0 6 * * *"
  },
  "ExternalService": {
    "Enabled": false,
    "Endpoint": "<url-del-servicio-externo>"
  },
  "Jwt": {
    "Key": "<clave-aleatoria-de-32-o-mas-caracteres>",
    "Issuer": "TankMonitoring.API",
    "Audience": "TankMonitoring.Client",
    "ExpiryMinutes": 60
  },
  "ApiKeys": {
    "JobKey": "<clave-de-api-de-jobs>"
  }
}
