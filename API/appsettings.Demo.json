{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Hangfire": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Demo": {
    "Enabled": true
  },
  "Reader": {
    "Mode": "Simulated"
  },
  "Sitio": {
    "Id": 1
  },
  "Simulation": {
    "Seed": 42,
    "DemoMode": true,
    "ConsumptionScale": 30,
    "ResponseDelayMs": 0,
    "TemperatureMinC": 5,
    "TemperatureMaxC": 40,
    "Delivery": {
      "FirstAfterMinutes": 1,
      "IntervalMinutes": 10,
      "MinLiters": 4000,
      "MaxLiters": 8000,
      "FlowLitersPerMinute": 3000,
      "LowLevelPercent": 20
    },
    "Tanks": [
      { "Number": 1, "Code": "A", "CapacityLiters": 40000, "DiameterMm": 2400, "InitialPercent": 70, "BaseLitersPerHour": 500, "Beta": 0.0012, "BaseTemperatureC": 24 },
      { "Number": 2, "Code": "B", "CapacityLiters": 20000, "DiameterMm": 2000, "InitialPercent": 55, "BaseLitersPerHour": 200, "Beta": 0.0012, "BaseTemperatureC": 24 },
      { "Number": 3, "Code": "C", "CapacityLiters": 30000, "DiameterMm": 2200, "InitialPercent": 45, "BaseLitersPerHour": 300, "Beta": 0.0008, "BaseTemperatureC": 25 },
      { "Number": 4, "Code": "C", "CapacityLiters": 30000, "DiameterMm": 2200, "InitialPercent": 80, "BaseLitersPerHour": 150, "Beta": 0.0008, "BaseTemperatureC": 25 }
    ]
  },
  "Jobs": {
    "Enabled": true,
    "InventoryCron": "*/1 * * * *",
    "DeliveriesCron": "*/2 * * * *",
    "RunOnStart": true,
    "Dashboard": false,
    "WorkerCount": 2
  },
  "Database": {
    "Initialize": true
  },
  "ExternalService": {
    "Enabled": false
  },
  "Swagger": {
    "Enabled": false
  },
  "RateLimit": {
    "PermitPerMinute": 120
  },
  "Jwt": {
    "Issuer": "TankMonitoring.API",
    "Audience": "TankMonitoring.Client",
    "ExpiryMinutes": 60
  }
}
