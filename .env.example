# Copia este archivo a .env (no se versiona) y reemplaza los valores.
# Genera valores aleatorios, por ejemplo:  openssl rand -hex 24

POSTGRES_DB=monitoring
POSTGRES_USER=monitoring
POSTGRES_PASSWORD=<cambiar-por-un-valor-aleatorio>

# Clave de firma JWT de la API, 32 caracteres o mas:  openssl rand -base64 48
JWT_KEY=<cambiar-por-un-valor-aleatorio-largo>

# Puerto unico expuesto (web) y direccion donde escucha en el host.
# 127.0.0.1 = solo el propio equipo (ideal con un tunel de Cloudflare en el mismo equipo).
WEB_BIND=127.0.0.1
WEB_PORT=8080

# Zona horaria de los contenedores (afecta las horas mostradas).
TZ=UTC
